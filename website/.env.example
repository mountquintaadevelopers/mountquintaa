# ── Mount Quintaa server config ─────────────────────────────
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env to git.

# Port for local development (Vercel ignores it)
PORT=3000
NODE_ENV=development

# Admin login username
ADMIN_USER=admin

# Admin password HASH (not the password itself!)
# Generate it with:  npm run make-password
ADMIN_PASSWORD_HASH=paste_hash_here

# Blog writer login (optional) - can only use the Blogs section, not the leads.
# Generate the hash with:  npm run make-password
# BLOG_USER=blogwriter
# BLOG_PASSWORD_HASH=paste_hash_here

# Random secret for signing login tokens — at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste_long_random_string_here

# Comma-separated list of allowed website origins (production)
# e.g. ALLOWED_ORIGIN=https://mountquintaa.com,https://www.mountquintaa.com
# Leave unset in development.
# ALLOWED_ORIGIN=

# ── Supabase (Dashboard -> Project Settings -> API) ─────────
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# The "service_role" secret key - server only, never put it in public/ files.
SUPABASE_SERVICE_ROLE_KEY=paste_service_role_key_here
# Optional: only if your table or bucket names differ from these defaults
# SUPABASE_LEADS_TABLE=leads
# SUPABASE_BLOGS_TABLE=blogs
# SUPABASE_BUCKET=blog-images
