datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

enum Role {
  ADMIN
  SCANNER
}
enum BookingType {
  SITE_VISIT
  LAUNCH_EVENT
}
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  email     String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([name])
  @@index([createdAt])
}

model AdminUser {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  role Role @default(SCANNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scannedBookings Booking[] @relation("ScannedBy")

  @@index([role])
}

model ContactMessage {
  id Int @id @default(autoincrement())

  name    String
  email   String
  phone   String
  message String? @db.Text
  // Website form fields: which form ("Contact Page", "Home — Popup", …),
  // consent checkbox, page it was sent from, client IP (rate limiting)
  source    String?
  consent   Boolean @default(false)
  pageUrl   String? @db.VarChar(500)
  ipAddress String? @db.VarChar(64)
  isFollowUped Boolean @default(true)
  adminNote String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([source])
  @@index([ipAddress, createdAt])
}

// Per-page SEO for mountquintaa.com, edited from the admin panel.
// The website reads it via the public GET /v1/seo; empty optional fields fall
// back to the website's defaults (e.g. ogTitle -> title, canonicalUrl -> site URL + path).
model SeoPage {
  id Int @id @default(autoincrement())

  slug          String  @unique @db.VarChar(100) // index, about, projects, contact, privacy, blogs
  pageName      String                           // label for the admin UI
  path          String                           // public path, e.g. /about (read-only)
  title         String  @db.VarChar(255)
  description   String  @db.Text
  keywords      String? @db.Text
  ogTitle       String? @db.VarChar(255)
  ogDescription String? @db.Text
  ogImage       String? @db.VarChar(500)
  canonicalUrl  String? @db.VarChar(500)
  noindex       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model WhatsAppUserLog {
  id Int @id @default(autoincrement())

  name  String
  phone String @unique

  visitCount    Int      @default(0)
  lastVisitedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([lastVisitedAt])
}


model Slot {
  id Int @id @default(autoincrement())

  date      DateTime
  startTime DateTime
  endTime   DateTime

  bookingType BookingType

  capacity Int @default(10)

  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([date])
  @@index([bookingType])
  @@index([isEnabled])
  @@index([startTime])
}


model Booking {
  id Int @id @default(autoincrement())

  bookingNumber String @unique

  userId Int
  slotId Int

  bookingType BookingType

  numberOfPeople Int @default(1)

  status BookingStatus @default(PENDING)



  scannedAt   DateTime?
  scannedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  user User @relation(fields: [userId], references: [id])

  slot Slot @relation(fields: [slotId], references: [id])

  scannedBy AdminUser? @relation("ScannedBy", fields: [scannedById], references: [id])

  @@index([userId])
  @@index([slotId])
  @@index([bookingType])
  @@index([status])
  @@index([scannedById])
  @@index([createdAt])
}




model BookingSetting {
  id Int @id @default(autoincrement())

  siteVisitEnabled   Boolean @default(true)
  launchEventEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
}